---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  current?: 'home' | 'projects' | 'crater' | 'classes' | 'simulator' | 'about';
  theme?: 'light' | 'dark';
}
const { title, description = 'Wildbloom Studio makes free D&D 5e homebrew, the Crater, and the TTRPG Hellebore.', current, theme = 'light' } = Astro.props;
import { url } from '../lib/url';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('seal-light.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Alegreya+Sans+SC:wght@500;700&family=Alegreya+Sans:ital,wght@0,400;0,500;0,700;1,400&family=Cormorant+SC:wght@500;600;700&family=Crimson+Pro:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap"
    />
    <slot name="head" />
  </head>
  <body>
    <div class="site" data-theme={theme}>
      <Nav current={current} />
      <slot />
      <Footer />
    </div>
  </body>
</html>
