---
import Base from '../layouts/Base.astro';
import Feature from './Feature.astro';
import { url } from '../lib/url';
import type { ClassData, OptionsSection } from '../lib/classPage';

interface Props { d: ClassData; name: string; slug: string; options: OptionsSection; simulator?: boolean }
const { d, name, slug, options: opt, simulator = false } = Astro.props;
const toc = [
  ['core', 'Core Traits'],
  ['becoming', `Becoming a ${name}`],
  ['table', 'Features Table'],
  ['features', 'Class Features'],
  [opt.id, opt.title],
  ['subclasses', 'Subclasses'],
  ['changelog', 'Playtest & Changelog'],
];
const version = d.playtest.version.replace('Version ', '');
---
<Base title={`${name} — Wildbloom classes`} current="classes" description={d.tagline}>
  <main class="wrap">
    <header class="class-head">
      <div>
        <ol class="crumbs caption">
          <li><a class="ws-link ws-link--quiet" href={url('classes/')}>Classes</a></li>
          <li>{name}</li>
        </ol>
        <h1 class="page-title">{name}</h1>
        <p class="class-head__tag">{d.tagline}</p>
        {d.flavor.map((p) => <p class="lore-text ws-prose" style="margin: 0 0 12px">{p}</p>)}
      </div>
      <div class="class-head__side">
        <span class="ws-badge ws-badge--dev label">Playtest</span>
        {simulator && <a class="ws-btn control" href={url(`simulator/?class=${slug}`)}>Compare in Simulator</a>}
        <a class="ws-btn ws-btn--secondary ws-btn--sm control" href="#changelog">Playtest notes</a>
        <p class="caption muted" style="margin: 0">Version {version}</p>
      </div>
    </header>
    <div class="ws-divider ws-divider--vine" role="separator" style="margin: 0 0 40px"><span class="ws-divider__mark"></span></div>

    <div class="chapter">
      <nav class="toc" aria-label="On this page">
        <p class="label">On this page</p>
        <ol class="control">
          {toc.map(([id, label], i) => <li><a href={`#${id}`} aria-current={i === 0 ? 'true' : 'false'}>{label}</a></li>)}
        </ol>
      </nav>

      <div style="min-width: 0">
        <details class="toc-mobile">
          <summary class="control">On this page</summary>
          <ol class="control">
            {toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
          </ol>
        </details>

        <section id="core" class="ch-sec" aria-labelledby="core-title">
          <h2 id="core-title" class="chapter-heading">Core Traits</h2>
          <div class="ws-divider ws-divider--plain" role="separator"></div>
          {d.creating.map((p) => <p class="rules-text ws-prose">{p}</p>)}
          <p class="rules-text ws-prose"><b>Quick Build.</b> {d.quick}</p>
          <div class="traits-grid" style={d.lore ? undefined : 'grid-template-columns: minmax(0, 1fr)'}>
            <div class="ws-tablewrap traits" role="region" aria-label={`Core ${name} traits`} tabindex="0">
              <table class="ws-table ws-table--fit">
                <caption class="section-heading">Core {name} Traits</caption>
                <tbody>
                  {d.traits.map(([k, v]) => (
                    <tr><th scope="row" class="table-head">{k}</th><td class="table-text">{v}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
            {d.lore && (
              <aside class="ws-callout ws-callout--lore" aria-label="Lore">
                <p class="ws-callout__label label">{d.lore.h.replace(/^Lore:\s*/, 'Lore · ')}</p>
                <p class="caption muted" style="margin: 0 0 8px">{d.lore.note}</p>
                {d.lore.p.map((p) => <p class="lore-text">{p.l && <b>{p.l} </b>}{p.t}</p>)}
              </aside>
            )}
          </div>
        </section>

        <section id="becoming" class="ch-sec" aria-labelledby="becoming-title">
          <h2 id="becoming-title" class="chapter-heading">Becoming a {name}</h2>
          <div class="ws-divider ws-divider--plain" role="separator"></div>
          <div class="two-col">
            {d.becoming.map((b) => (
              <div>
                <h3 class="sub-heading ws-h">{b.label}</h3>
                <ul class="ws-bullets rules-text">{b.items.map((i) => <li>{i}</li>)}</ul>
              </div>
            ))}
          </div>
        </section>

        <section id="table" class="ch-sec" aria-labelledby="table-title">
          <h2 id="table-title" class="chapter-heading">Class Features Table</h2>
          <div class="ws-divider ws-divider--plain" role="separator"></div>
          <div class="ws-tablewrap" role="region" aria-label={`${name} features table`} tabindex="0">
            <table class="ws-table">
              <caption class="section-heading">{name} Features</caption>
              <thead>
                <tr>{d.tableHead.map((h, i) => <th scope="col" class={`table-head${i === 2 ? ' ws-left' : ''}`}>{h}</th>)}</tr>
              </thead>
              <tbody>
                {d.table.map((row) => (
                  <tr>
                    {row.map((c, i) =>
                      i === 0 ? <th scope="row" class="table-text">{c}</th> : <td class={`table-text${i === 2 ? ' ws-left' : ''}`}>{c}</td>,
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section id="features" class="ch-sec" aria-labelledby="features-title">
          <h2 id="features-title" class="chapter-heading">Class Features</h2>
          <div class="ws-divider ws-divider--plain" role="separator"></div>
          <p class="rules-text ws-prose">{d.featuresIntro}</p>
          {d.feats.map((f) => <Feature feat={f} />)}
        </section>

        <section id={opt.id} class="ch-sec" aria-labelledby={`${opt.id}-title`}>
          <h2 id={`${opt.id}-title`} class="chapter-heading">{opt.title}</h2>
          <div class="ws-divider ws-divider--plain" role="separator"></div>
          <p class="rules-text ws-prose">{opt.intro}</p>
          <div class="ws-tablewrap" role="region" aria-label={`${opt.title} summary`} tabindex="0">
            <table class="ws-table ws-table--fit">
              <caption class="section-heading">{opt.title}</caption>
              <thead>
                <tr>
                  {opt.head.map((h, i) => <th scope="col" class={`table-head${i === 0 || i === opt.head.length - 1 ? ' ws-left' : ''}`}>{h}</th>)}
                </tr>
              </thead>
              <tbody>
                {opt.rows.map((row) => (
                  <tr>
                    {row.map((c, i) =>
                      i === 0 ? <th scope="row" class="table-text ws-left">{c}</th> : <td class={`table-text${i === row.length - 1 ? ' ws-left' : ''}`}>{c}</td>,
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {opt.items.map((c) => (
            <section class="ws-feature">
              <header class="ws-feature__head">
                <h3 class="sub-heading ws-feature__name">{c.n}</h3>
                {c.v && <span class="ws-badge ws-badge--level label">{c.v.replace(/[()]/g, '')}</span>}
              </header>
              <p class="rules-text">{c.t}</p>
              {c.more?.map((m) => <p class="rules-text">{m}</p>)}
            </section>
          ))}
        </section>

        <section id="subclasses" class="ch-sec" aria-labelledby="subclasses-title">
          <h2 id="subclasses-title" class="chapter-heading">{name} Subclasses</h2>
          <div class="ws-divider ws-divider--plain" role="separator"></div>
          <p class="rules-text ws-prose">Two subclasses are available at level 3: {d.subs.map((s) => s.name).join(' and ')}.</p>
          {d.subs.map((s) => (
            <article class="subclass" id={s.id}>
              <h3 class="section-heading">{name} Subclass: {s.name}</h3>
              <p class="caption muted"><i>{s.tagline}</i></p>
              <p class="lore-text ws-prose">{s.intro}</p>
              {s.feats.map((f) => <Feature feat={f} level={4} />)}
            </article>
          ))}
        </section>

        <section id="changelog" class="ch-sec" aria-labelledby="changelog-title">
          <h2 id="changelog-title" class="chapter-heading">Playtest &amp; Changelog</h2>
          <div class="ws-divider ws-divider--plain" role="separator"></div>
          <aside class="ws-callout ws-callout--rules">
            <p class="ws-callout__label label">{d.playtest.version}</p>
            <p class="rules-text">{d.playtest.text}</p>
          </aside>
          {d.changelog.map((c) => (
            <>
              <h3 class="sub-heading ws-h">{c.v}</h3>
              <ul class="ws-bullets rules-text">{c.items.map((i) => <li>{i}</li>)}</ul>
            </>
          ))}
          <h3 class="sub-heading ws-h">Legal</h3>
          {d.legal.map((p) => <p class="caption muted">{p}</p>)}
        </section>

        <nav class="pager" aria-label="More classes">
          <span></span>
          <a class="pager__index ws-btn ws-btn--secondary ws-btn--sm control" href={url('classes/')}>All classes</a>
          <span></span>
        </nav>
      </div>
    </div>
  </main>
</Base>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const byId = new Map(links.map((a) => [a.hash.slice(1), a]));
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a) => a.setAttribute('aria-current', 'false'));
        byId.get(e.target.id)?.setAttribute('aria-current', 'true');
      }
    },
    { rootMargin: '-20% 0px -70% 0px' },
  );
  byId.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
</script>
