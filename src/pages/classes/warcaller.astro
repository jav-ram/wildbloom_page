---
import ClassPage from '../../components/ClassPage.astro';
import type { ClassData } from '../../lib/classPage';
import raw from '../../data/warcaller.json';

const d = raw as unknown as ClassData & { criesIntro: string; cryTable: string[][]; cries: { n: string; v?: string; t: string }[] };
const options = {
  id: 'cries',
  title: 'Battle Cries',
  intro: d.criesIntro,
  head: ['Cry', 'Level', 'Effect in short'],
  rows: d.cryTable,
  items: d.cries,
};
---
<ClassPage d={d} name="Warcaller" slug="warcaller" simulator options={options} />
