{
  // Static site: Cloudflare serves the built dist/ folder. The name must match the Worker/project name in the dashboard.
  "name": "wildbloom-page",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./dist",
    // Unknown URLs get dist/404.html with a real 404 status.
    "not_found_handling": "404-page"
  }
}
